    <!-- Preference screens: rounded card rows, section headers, no empty icon space. -->
    <style name="PreferenceThemeOverlay" parent="BasePreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
        <item name="preferenceStyle">@style/GePreference</item>
        <item name="preferenceScreenStyle">@style/GePreference.Screen</item>
        <item name="preferenceCategoryStyle">@style/GePreference.Category</item>
        <item name="switchPreferenceStyle">@style/GePreference.Switch</item>

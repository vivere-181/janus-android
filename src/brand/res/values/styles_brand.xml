    <!-- Remote input's mouse buttons: large tonal buttons, Google-style. -->
    <style name="KdeConnectButton.IconButton" parent="Widget.Material3.Button.TonalButton">
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">28dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="KdeConnectButton.IconButton.Secondary" parent="Widget.Material3.Button.TonalButton">

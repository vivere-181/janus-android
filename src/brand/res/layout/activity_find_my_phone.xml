<?xml version="1.0" encoding="utf-8"?>
<!-- ge.connect: redesign of upstream's activity_find_my_phone.xml (same view IDs). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="org.kde.kdeconnect.plugins.findmyphone.FindMyPhoneActivity">

    <include layout="@layout/toolbar" android:id="@+id/toolbar_layout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/ringing_badge">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ms_notifications_active_filled"
                app:tint="?attr/colorOnPrimaryContainer" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/findmyphone_ringing_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/findmyphone_ringing_text"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bFindMyPhone"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/findmyphone_found"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            app:cornerRadius="48dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  ge.connect: redesign of upstream's activity_mousepad.xml (same view IDs, so MousePadActivity's
  touch, keyboard and gyro handling is unchanged). The touchpad panel is decoration only: it
  doesn't take touches, so they still reach the activity.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="org.kde.kdeconnect.plugins.mousepad.MousePadActivity">

    <include layout="@layout/toolbar" android:id="@+id/toolbar_layout" />

    <RelativeLayout
        android:id="@+id/mousepad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/touchpad_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/mouse_buttons"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/touchpad_surface"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ms_trackpad_input"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/mousepad_info"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <org.kde.kdeconnect.plugins.mousepad.KeyListenerView
            android:id="@+id/keyListener"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/mouse_buttons"
            android:contentDescription="@string/mousepad_info_no_gestures"
            android:focusedByDefault="true" />

        <LinearLayout
            android:id="@+id/mouse_buttons"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mouse_click_left"
                style="@style/KdeConnectButton.IconButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:contentDescription="@string/left_click"
                app:icon="@drawable/ms_left_click" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mouse_click_middle"
                style="@style/KdeConnectButton.IconButton.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/middle_click" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mouse_click_right"
                style="@style/KdeConnectButton.IconButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:contentDescription="@string/right_click"
                app:icon="@drawable/ms_right_click" />
        </LinearLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
